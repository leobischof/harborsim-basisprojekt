+// HarborSim – DockingOrderComparer.cs – Leo Bischof (12320283)
+using System.Collections.Generic;
+
+namespace HarborSim
+{
+    // Reihenfolge, in der die Schiffe abgefertigt werden:
+    // zuerst Schiffe mit Vorrang (Passagierschiffe), dann die übrigen.
+    // Innerhalb einer Gruppe nach Id, also in der Reihenfolge der CSV.
+    public class DockingOrderComparer : IComparer<Ship>
+    {
+        public int Compare(Ship x, Ship y)
+        {
+            if (x.HasPriority && !y.HasPriority)
+            {
+                return -1;
+            }
+            if (!x.HasPriority && y.HasPriority)
+            {
+                return 1;
+            }
+            // Sort ist nicht stabil (gleiche Elemente können die Plätze tauschen),
+            // deshalb entscheidet bei Gleichstand die Id
+            return x.Id.CompareTo(y.Id);
+        }
+    }
+}
