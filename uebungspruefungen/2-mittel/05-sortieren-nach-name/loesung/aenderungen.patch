+// HarborSim – ShipNameComparer.cs – Leo Bischof (12320283)
+using System;
+using System.Collections.Generic;
+
+namespace HarborSim
+{
+    // Sortiert Schiffe nur nach Name, alphabetisch.
+    // Zweite Sortierregel neben ShipComparer (Länge) -> eigene Klasse.
+    public class ShipNameComparer : IComparer<Ship>
+    {
+        // Rückgabe: < 0 -> x zuerst, 0 -> gleich, > 0 -> y zuerst
+        public int Compare(Ship x, Ship y)
+        {
+            return string.Compare(x.Name, y.Name, StringComparison.Ordinal);
+        }
+    }
+}
