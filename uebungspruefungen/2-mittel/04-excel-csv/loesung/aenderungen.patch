+        // Österreichisches Excel speichert CSV mit ";" als Trennzeichen und "," als Dezimalzeichen.
+        // Erkannt wird das an der Kopfzeile. Dann wird jede Zeile ins normale Format umgebaut:
+        // erst "," -> "." (Dezimalzeichen), danach ";" -> "," (Trennzeichen). Die Reihenfolge ist wichtig.
+        private static string[] ConvertExcelLines(string[] lines)
+        {
+            if (lines.Length == 0 || !lines[0].Contains(";"))
+            {
+                return lines;
+            }
+            for (int i = 0; i < lines.Length; i++)
+            {
+                lines[i] = lines[i].Replace(',', '.').Replace(';', ',');
+            }
+            return lines;
+        }
+
